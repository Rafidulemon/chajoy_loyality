# Copy to .env.local (git-ignored) and fill in. See "Configuration" in README.md. Never commit real values.

NEXT_PUBLIC_APP_NAME=ChaJoy Loyalty

# --- Database (Neon Postgres) -------------------------------------------------------------------------------------
# Pooled connection string: used by the app.
DATABASE_URL=
# Direct (unpooled) connection string: used by migrations (prisma.config.ts) and by the database tests.
DATABASE_URL_UNPOOLED=
# Connections per server instance (default 5).
# DB_POOL_MAX=5

# --- Security -----------------------------------------------------------------------------------------------------
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keys the code, PIN, QR and IP hashes. Changing it makes every existing staff PIN stop working (each needs a reset).
AUTH_SECRET=
# The public origin, for the cross-site request check (e.g. https://loyalty.example.com). Optional in development.
# APP_ORIGIN=http://localhost:3000

# --- Sign-in codes ------------------------------------------------------------------------------------------------
# "sms": a random 6-digit code is sent. "fixed": everyone uses DEV_OTP_CODE. DEVELOPMENT ONLY: refused in production.
OTP_MODE=fixed
DEV_OTP_CODE=
# "console" prints messages on the server instead of sending them. Refused in production until a gateway adapter exists.
SMS_PROVIDER=console

# --- Demo data (development only) ---------------------------------------------------------------------------------
# The 6-digit PIN the seed gives every demo staff account (npm run db:seed).
SEED_STAFF_PIN=

# --- Scheduler ----------------------------------------------------------------------------------------------------
# 24+ random characters. Lets a scheduler call /api/cron/sms with "Authorization: Bearer <value>". Without it that route is off.
# CRON_SECRET=
